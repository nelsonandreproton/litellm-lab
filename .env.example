# Copy to .env and fill in real values. Never commit .env.
# Use hex-only secrets: characters like # $ / @ break the Postgres URL and Compose
# interpolation. See README "Generate secrets".

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=<64 hex chars>
POSTGRES_PORT=5432

# LiteLLM expects the master key to start with sk-
LITELLM_MASTER_KEY=sk-<64 hex chars>
# Encrypts credentials LiteLLM stores in Postgres. Never change it once data exists.
LITELLM_SALT_KEY=sk-<64 hex chars>

# Shared secret between LiteLLM and llama-server
LLAMACPP_API_KEY=<64 hex chars>
